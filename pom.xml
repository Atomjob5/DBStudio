<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dbstudio</groupId>
    <artifactId>dbstudio-parent</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>

    <name>DBStudio</name>
    <description>A local database management tool built with web technologies.</description>
    <url>https://github.com/Atomjob5/DBStudio</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/Atomjob5/DBStudio.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Atomjob5/DBStudio.git</developerConnection>
        <url>https://github.com/Atomjob5/DBStudio</url>
        <tag>v1.1.0</tag>
    </scm>

    <modules>
        <module>database-spi</module>
        <module>database-mysql</module>
        <module>database-oracle-common</module>
        <module>database-oracle</module>
        <module>database-oceanbase-oracle</module>
        <module>application-core</module>
        <module>editor-web</module>
        <module>server-app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <spring-boot.version>2.7.18</spring-boot.version>
        <junit.version>5.13.4</junit.version>
        <mysql.connector.version>9.7.0</mysql.connector.version>
        <oracle.jdbc.version>19.31.0.0</oracle.jdbc.version>
        <oceanbase.connector.version>2.4.17</oceanbase.connector.version>
        <druid.version>1.2.28</druid.version>
        <sqlite.version>3.50.3.0</sqlite.version>
        <commons.csv.version>1.14.1</commons.csv.version>
        <commons.lang3.version>3.16.0</commons.lang3.version>
        <poi.version>5.4.1</poi.version>
        <jna.version>5.17.0</jna.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <maven.compiler.version>3.14.0</maven.compiler.version>
        <maven.surefire.version>3.5.3</maven.surefire.version>
        <animal-sniffer.version>1.23</animal-sniffer.version>
        <java8.signature.version>1.0</java8.signature.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Boot 2.7 imports Oracle's 21.5 BOM; DBStudio intentionally targets ojdbc8 19.31. -->
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc8</artifactId>
                <version>${oracle.jdbc.version}</version>
            </dependency>
            <!-- POI 5.4 pulls Commons Compress 1.27, which requires ArrayFill from Commons Lang 3.16. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons.lang3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.version}</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
                <version>${animal-sniffer.version}</version>
                <executions>
                    <execution>
                        <id>java-8-api-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <signature>
                                <groupId>org.codehaus.mojo.signature</groupId>
                                <artifactId>java18</artifactId>
                                <version>${java8.signature.version}</version>
                            </signature>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
